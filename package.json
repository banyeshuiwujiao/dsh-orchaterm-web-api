{
  "name": "dsh-orchaterm-web-api",
  "version": "0.6.1",
  "description": "OrcaTerm (腾讯云或壳终端) 反代接入 DSH 模型选择器",
  "type": "module",
  "main": "lib/provider.js",
  "exports": {
    ".": "./lib/provider.js",
    "./provider": "./lib/provider.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "backend",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/config_check.mjs && node test/smoke.mjs && node test/token_refresh.mjs && node test/malformed_envelope.mjs && node test/report_timeout.mjs && node test/empty_response_rescue.mjs && node test/compaction_summary.mjs",
    "test:config": "node test/config_check.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:token-refresh": "node test/token_refresh.mjs",
    "test:empty-response": "node test/empty_response_rescue.mjs",
    "test:live": "node test/manual_live.mjs",
    "test:live:regression": "node test/live_regression.mjs",
    "install-plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1",
    "test:malformed": "node test/malformed_envelope.mjs",
    "test:report-timeout": "node test/report_timeout.mjs",
    "test:compaction": "node test/compaction_summary.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "orcaterm",
    "orchaterm",
    "provider",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "Apache-2.0"
}
